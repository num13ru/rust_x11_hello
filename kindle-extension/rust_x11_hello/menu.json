{
  "items": [
    {
      "name": "Run Rust X11 Hello (WiFi)",
      "action": "sh -c 'RUST_X11_HELLO_COMPANION=192.168.0.12 RUST_X11_HELLO_WATCHDOG_SECONDS=300 sh bin/run.sh'"
    },
    {
      "name": "Run Rust X11 Hello (90s)",
      "action": "sh bin/run.sh"
    },
    {
      "name": "Run Bonjour Diagnostic (30s)",
      "action": "sh -c 'RUST_X11_HELLO_BONJOUR_DIAGNOSTIC=1 RUST_X11_HELLO_BONJOUR_TIMEOUT_MS=30000 RUST_X11_HELLO_WATCHDOG_SECONDS=30 sh bin/run.sh'"
    },
    {
      "name": "Run mDNS Services Dump",
      "action": "sh -c 'RUST_X11_HELLO_BONJOUR_DIAGNOSTIC=1 RUST_X11_HELLO_BONJOUR_SERVICE=_services._dns-sd._udp.local. RUST_X11_HELLO_BONJOUR_TIMEOUT_MS=20000 RUST_X11_HELLO_WATCHDOG_SECONDS=25 sh bin/run.sh'"
    },
    {
      "name": "Stop Rust X11 Hello",
      "action": "sh bin/stop.sh"
    },
    {
      "name": "Show Last Result",
      "action": "sh bin/show.sh"
    }
  ]
}